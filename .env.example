# Kopirajte u .env i prilagodite. Sve varijable su javne (PUBLIC_) jer je web statičan.

# Kanonska adresa weba (bez završne kose crte)
PUBLIC_SITE_URL=https://www.zagi.hr
# true = noindex za demo objavu (robots.txt Disallow + meta robots)
PUBLIC_NOINDEX=false

# --- WebBooking (WebBookingPro / Sigma Grupa) ---
# Postojeća stranica rezervacije hotela; ?jez=hr|en dodaje se automatski
PUBLIC_WEBBOOKING_URL=https://www.zagi.hr/booknow.php
# hotelId u sustavu WebBookingPro (pročitan s postojeće booknow.php stranice)
PUBLIC_WBP_HOTEL_ID=33419
# true = gumbi vode na /hr/rezervacija/ i /en/booking/ s ugrađenim WBP widgetom
PUBLIC_WBP_EMBED_ENABLED=false

# --- Obrasci (statičan web) ---
# URL koji prima POST obrasca (npr. Formspree, Netlify Forms, vlastiti endpoint).
# Prazno = demo način (validacija + ponuda slanja e-mailom).
PUBLIC_FORM_ACTION=

# --- CMS (Keystatic) ---
PUBLIC_CMS_ENABLED=false

# --- AI chatbot ---
PUBLIC_CHATBOT_ENABLED=false
PUBLIC_CHATBOT_PROVIDER=
PUBLIC_CHATBOT_SCRIPT_URL=
PUBLIC_CHATBOT_ID=
