---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSlider from '@/components/HeroSlider.astro';
import Section from '@/components/Section.astro';
import Card from '@/components/Card.astro';
import ReviewBadge from '@/components/ReviewBadge.astro';
import PracticalInfo from '@/components/PracticalInfo.astro';
import TextImage from '@/components/TextImage.astro';
import Button from '@/components/Button.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { useTranslations } from '@/i18n';
import { pathFor, type PageKey } from '@/i18n/routes';
import { getGlobal, getLocalized, getSettings } from '@/lib/content';
import { hotelSchema, websiteSchema } from '@/lib/schema';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const { data: page, locale: contentLocale } = await getLocalized('pages', locale, 'home');
const g = await getGlobal();
const settings = await getSettings(locale);

const jsonLd = [
  hotelSchema(g, locale, {
    description: page.seo.description,
    images: (page.heroSlides ?? []).map((s) => s.image.src),
    amenities: settings.practicalInfo.map((i) => i.title),
  }),
  websiteSchema(locale, g.hotelName),
];
---

<BaseLayout locale={locale} pageKey="home" seo={page.seo} contentLocale={contentLocale} transparentHeader jsonLd={jsonLd}>
  {
    page.heroSlides && page.heroSlides.length > 0 && (
      <HeroSlider
        slides={page.heroSlides}
        locale={locale}
        heading={page.hero.title}
        intervalMs={g.slider.intervalMs}
        maxSmall={g.slider.maxSlidesOnSmallScreens}
      />
    )
  }

  {
    page.featureCards && (
      <Section
        id="ponuda"
        eyebrow={page.featureCardsIntro?.eyebrow}
        heading={page.featureCardsIntro?.heading}
        lead={page.featureCardsIntro?.lead}
      >
        <div class="cards">
          {page.featureCards.map((card, i) => (
            <Card
              href={pathFor(card.page as PageKey, locale)}
              title={card.title}
              text={card.text}
              image={card.image}
              linkLabel={t('common.readMore')}
              index={i}
              sizes="(min-width: 64em) 45vw, (min-width: 40em) 50vw, 100vw"
            />
          ))}
        </div>
      </Section>
    )
  }

  <section class="proof" aria-label={t('reviews.label')}>
    <div class="container">
      <ReviewBadge locale={locale} rating={g.reviews.rating} count={g.reviews.count} url={g.reviews.url} source={g.reviews.source} />
    </div>
  </section>

  <Section id="info" tone="surface" tight>
    <PracticalInfo items={settings.practicalInfo} heading={t('info.title')} />
  </Section>

  {
    page.intro && (
      <Section id="o-nama">
        <TextImage
          eyebrow={page.intro.eyebrow}
          heading={page.intro.heading}
          paragraphs={page.intro.paragraphs}
          image={page.intro.image}
          reverse
        >
          <Button href={pathFor('about', locale)} variant="link" icon="arrowRight">
            {t('nav.about')}
          </Button>
        </TextImage>
      </Section>
    )
  }

  {page.cta && <CtaBanner locale={locale} {...page.cta} />}
</BaseLayout>

<style>
  .cards {
    display: grid;
    gap: clamp(1rem, 2.5vw, 2rem);
  }
  @media (min-width: 40em) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Editorijalni ritam: druga i četvrta kartica spuštene na velikim zaslonima */
  @media (min-width: 64em) {
    .cards {
      padding-bottom: var(--s-6);
    }
    .cards > :global(:nth-child(even)) {
      translate: 0 var(--s-6);
    }
  }
  .proof {
    padding-block: var(--s-4);
    border-block: 1px solid var(--c-line);
  }
</style>
