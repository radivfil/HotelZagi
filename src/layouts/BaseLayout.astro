---
import '@/styles/global.css';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileCta from '@/components/MobileCta.astro';
import ChatWidget from '@/components/ChatWidget.astro';
import ConsentBanner from '@/components/ConsentBanner.astro';
import { getLocale } from '@/i18n/config';
import { useTranslations } from '@/i18n';
import type { PageKey } from '@/i18n/routes';
import { getGlobal } from '@/lib/content';
import { breadcrumbSchema } from '@/lib/schema';
import type { Crumb } from '@/components/Breadcrumbs.astro';

// Samohostani fontovi: URL-ovi s hashom za preload + @font-face
import serif600 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url';
import serif600ext from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-ext-600-normal.woff2?url';
import serif500italic from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-italic.woff2?url';
import serif500italicExt from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-ext-500-italic.woff2?url';
import sans from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import sansExt from '@fontsource-variable/figtree/files/figtree-latin-ext-wght-normal.woff2?url';

interface Props {
  locale: string;
  pageKey?: PageKey;
  seo: { title: string; description: string; ogImage?: string; noindex?: boolean };
  /** Jezik prikazanog sadržaja (razlikuje se od `locale` kad je prikazan rezervni prijevod) */
  contentLocale?: string;
  transparentHeader?: boolean;
  crumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  standalone?: boolean;
  showMobileCta?: boolean;
}

const {
  locale,
  pageKey = 'home',
  seo,
  contentLocale = locale,
  transparentHeader = false,
  crumbs,
  jsonLd = [],
  standalone = false,
  showMobileCta = true,
} = Astro.props;
const t = useTranslations(locale);
const global = await getGlobal();
const lang = getLocale(locale).hreflang;
const structured = crumbs && crumbs.length > 1 ? [...jsonLd, breadcrumbSchema(crumbs)] : jsonLd;

const LATIN = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';
const LATIN_EXT = 'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF';
const face = (family: string, url: string, weight: string, range: string, style = 'normal') =>
  `@font-face{font-family:'${family}';font-style:${style};font-display:swap;font-weight:${weight};src:url(${url}) format('woff2');unicode-range:${range}}`;
const fontCss = [
  face('Cormorant Garamond', serif600, '600', LATIN),
  face('Cormorant Garamond', serif600ext, '600', LATIN_EXT),
  face('Cormorant Garamond', serif500italic, '500', LATIN, 'italic'),
  face('Cormorant Garamond', serif500italicExt, '500', LATIN_EXT, 'italic'),
  face('Figtree Variable', sans, '300 900', LATIN),
  face('Figtree Variable', sansExt, '300 900', LATIN_EXT),
  // Rezervni fontovi s prilagođenim metrikama – manji pomak izgleda pri zamjeni fonta
  `@font-face{font-family:'Figtree Fallback';src:local('Arial');size-adjust:101%;ascent-override:95%;descent-override:25%;line-gap-override:0%}`,
  `@font-face{font-family:'Cormorant Fallback';src:local('Georgia');size-adjust:84%;ascent-override:110%;descent-override:34%;line-gap-override:0%}`,
].join('');
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#faf7f2" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serif600} as="font" type="font/woff2" crossorigin />
    {locale === 'hr' && <link rel="preload" href={sansExt} as="font" type="font/woff2" crossorigin />}
    <style is:inline set:html={fontCss} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <Seo
      title={seo.title}
      description={seo.description}
      locale={locale}
      pageKey={standalone ? undefined : pageKey}
      ogImage={seo.ogImage}
      noindex={seo.noindex}
      jsonLd={structured}
      standalone={standalone}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip.toMain')}</a>
    <Header locale={locale} pageKey={pageKey} transparent={transparentHeader} />
    <main id="main" tabindex="-1" lang={contentLocale !== locale ? getLocale(contentLocale).hreflang : undefined}>
      {
        contentLocale !== locale && (
          <p class="fallback-notice container">
            {t('lang.fallbackNotice')} <strong>{getLocale(contentLocale).name}</strong>
          </p>
        )
      }
      <slot />
    </main>
    <Footer locale={locale} />
    {showMobileCta && <MobileCta locale={locale} phone={global.phones.main} />}
    <ConsentBanner locale={locale} />
    <ChatWidget locale={locale} />

    <script>
      // Suptilno otkrivanje pri scrollu – nikad ne blokira sadržaj
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target);
              }
            }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
        // sigurnosna mreža: nakon 3 s prikaži sve što je ostalo skriveno iznad trenutne pozicije
        window.setTimeout(() => {
          els.forEach((el) => {
            if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('is-revealed');
          });
        }, 3000);
      }
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
  .fallback-notice {
    padding-top: calc(var(--header-h) + var(--s-2));
    font-size: var(--step--1);
    color: var(--c-text-muted);
  }
</style>
