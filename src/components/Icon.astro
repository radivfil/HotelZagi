  ev: '<path d="M5 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16M3 21h14M15 10h2a2 2 0 0 1 2 2v4a1.5 1.5 0 0 0 3 0V8l-3-3"/><path d="m10 7-2 4h4l-2 4"/>',
  breakfast: '<path d="M4 10h12v4a6 6 0 0 1-12 0v-4ZM16 11h1.5a2.5 2.5 0 0 1 0 5H16M7 3v3M10 3v3M13 3v3"/>',
  car: '<path d="M5 17h14v-4.5l-2-5.5H7l-2 5.5V17ZM5 17v2M19 17v2M7.5 13.5h.01M16.5 13.5h.01M4 12h16"/>',
  pet: '<circle cx="11" cy="4.5" r="1.8"/><circle cx="17.5" cy="7.5" r="1.8"/><circle cx="4.5" cy="9" r="1.8"/><circle cx="19" cy="14" r="1.6"/><path d="M8 20c-2 0-3-1.5-2.4-3.2C6.5 14 8.5 11 11.5 11s5 3 5.6 5.4c.5 2-1 3.6-3 3.6-1.3 0-2.1-.6-3-.6s-1.8.6-3.1.6Z"/>',
