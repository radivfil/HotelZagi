---
/**
 * Lightbox na nativnom <dialog> elementu: zarobljen fokus i Escape dolaze iz preglednika.
 * Dodatno: strelice tipkovnice, swipe, brojač i opis. Radi sa svakim spremnikom
 * [data-lightbox-group] čiji elementi imaju [data-lightbox-item].
 */
import Icon from './Icon.astro';
import { useTranslations } from '@/i18n';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<dialog class="lightbox" aria-label={t('lightbox.label')} data-lightbox data-counter={t('lightbox.counter')}>
  <div class="lightbox__frame">
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" data-lightbox-img />
      <figcaption class="lightbox__caption">
        <span data-lightbox-caption></span>
        <span class="lightbox__count" data-lightbox-count></span>
      </figcaption>
    </figure>
    <button type="button" class="lightbox__btn lightbox__close" data-lightbox-close aria-label={t('common.close')}>
      <Icon name="close" size={26} />
    </button>
    <button type="button" class="lightbox__btn lightbox__prev" data-lightbox-prev aria-label={t('common.previous')}>
      <Icon name="chevronLeft" size={28} />
    </button>
    <button type="button" class="lightbox__btn lightbox__next" data-lightbox-next aria-label={t('common.next')}>
      <Icon name="chevronRight" size={28} />
    </button>
  </div>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(16 13 11 / 0.96);
    color: #fff;
  }
  .lightbox::backdrop {
    background: rgb(16 13 11 / 0.9);
  }
  .lightbox[open] {
    display: grid;
  }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] {
      animation: lb-in var(--dur-m) var(--ease-out);
    }
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lightbox__frame {
    position: relative;
    display: grid;
    place-items: center;
    padding: 4rem 0.5rem 1rem;
    touch-action: pan-y;
  }
  .lightbox__figure {
    display: grid;
    gap: var(--s-2);
    justify-items: center;
    max-width: 100%;
  }
  .lightbox__img {
    max-width: min(100%, 1600px);
    max-height: calc(100dvh - 9rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-s);
  }
  .lightbox__caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: center;
    padding-inline: var(--s-2);
    font-size: var(--step--1);
    text-align: center;
    color: rgb(255 255 255 / 0.88);
  }
  .lightbox__count {
    color: rgb(255 255 255 / 0.7);
    font-variant-numeric: tabular-nums;
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.35);
    color: #fff;
    transition: background-color var(--dur-s);
  }
  .lightbox__btn:hover {
    background: rgb(255 255 255 / 0.15);
  }
  .lightbox__close {
    top: 0.75rem;
    right: 0.75rem;
  }
  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    translate: 0 -50%;
  }
  .lightbox__prev {
    left: 0.75rem;
  }
  .lightbox__next {
    right: 0.75rem;
  }
  @media (max-width: 47.99em) {
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 0.75rem;
      translate: none;
    }
    .lightbox__frame {
      padding-bottom: 5rem;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lightbox-count]')!;
    let items: HTMLElement[] = [];
    let index = 0;

    const render = () => {
      const item = items[index];
      if (!item) return;
      img.src = item.dataset.full!;
      if (item.dataset.srcset) {
        img.srcset = item.dataset.srcset;
        img.sizes = '100vw';
      }
      img.alt = item.dataset.alt ?? '';
      caption.textContent = item.dataset.caption || item.dataset.alt || '';
      count.textContent = (dialog.dataset.counter ?? '{i} / {n}').replace('{i}', String(index + 1)).replace('{n}', String(items.length));
      // unaprijed učitaj susjednu fotografiju
      const next = items[(index + 1) % items.length];
      if (next) new Image().src = next.dataset.full!;
    };
    const go = (dir: number) => {
      index = (index + dir + items.length) % items.length;
      render();
    };

    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-lightbox-item]');
      if (!trigger) return;
      e.preventDefault();
      const group = trigger.closest('[data-lightbox-group]');
      items = [...(group?.querySelectorAll<HTMLElement>('[data-lightbox-item]') ?? [trigger])].filter(
        (el) => !el.closest('[hidden]'),
      );
      index = Math.max(0, items.indexOf(trigger));
      render();
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    });

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      img.removeAttribute('src');
      img.removeAttribute('srcset');
    });
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => go(-1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => go(1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(1);
      if (e.key === 'ArrowLeft') go(-1);
    });
    // klik na tamnu pozadinu zatvara
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).classList.contains('lightbox__frame')) dialog.close();
    });
    // swipe
    let x0 = 0;
    let y0 = 0;
    dialog.addEventListener('pointerdown', (e) => {
      x0 = e.clientX;
      y0 = e.clientY;
    });
    dialog.addEventListener('pointerup', (e) => {
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(e.clientY - y0)) go(dx < 0 ? 1 : -1);
    });
  }
</script>
