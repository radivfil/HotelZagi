---
/** Donja traka na mobitelu (< 768 px): Rezerviraj + Nazovi. Ostavlja mjesto chatbotu i kolačićima. */
import Icon from './Icon.astro';
import { useTranslations } from '@/i18n';
import { bookingHref } from '@/lib/links';
import { telHref } from '@/lib/content';

interface Props {
  locale: string;
  phone: string;
}
const { locale, phone } = Astro.props;
const t = useTranslations(locale);
---

<div class="mobile-cta">
  <a class="mobile-cta__call" href={telHref(phone)}>
    <Icon name="phone" size={20} />
    <span>{t('common.callUs')}</span>
  </a>
  <a class="mobile-cta__book" href={bookingHref(locale)} data-booking-link>
    <span>{t('book.cta')}</span>
    <Icon name="arrowRight" size={20} />
  </a>
</div>

<style>
  .mobile-cta {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-1);
    padding: 0.5rem var(--gutter) calc(0.5rem + env(safe-area-inset-bottom));
    background: rgb(250 247 242 / 0.97);
    border-top: 1px solid var(--c-line);
    box-shadow: 0 -4px 20px rgb(42 37 34 / 0.08);
  }
  .mobile-cta a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0 1.1rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
  }
  .mobile-cta__call {
    border: 1px solid var(--c-line);
    color: var(--c-text);
  }
  .mobile-cta__book {
    background: var(--c-accent);
    color: var(--c-on-accent);
  }
  .mobile-cta__book:hover {
    color: var(--c-on-accent);
    background: var(--c-accent-hover);
  }
  @media (min-width: 48em) {
    .mobile-cta {
      display: none;
    }
  }
  :global(body:has(.mobile-cta)) {
    padding-bottom: calc(64px + env(safe-area-inset-bottom));
  }
  @media (min-width: 48em) {
    :global(body:has(.mobile-cta)) {
      padding-bottom: 0;
    }
  }
</style>
