---
/**
 * Hero slider vođen podacima (src/content/pages/<jezik>/home.json → heroSlides).
 * - crossfade (animira se samo opacity/transform), automatska izmjena udesno svakih N ms
 *   (global.json → slider.intervalMs), u petlji
 * - ručni klik (strelice, točkice, swipe, tipkovnica) prelazi na slajd i ponovno pokreće odbrojavanje
 * - privremena pauza: hover nad tekstom slajda, fokus s tipkovnice, fokus u booking traci;
 *   trajna pauza samo gumbom pauza/play (WCAG 2.2.2)
 * - bez autoplaya uz prefers-reduced-motion (namjerno); u razvoju ?autoplay=1 to zaobilazi
 * - kontrole i booking traka su u zajedničkom „docku” (stupac) – ne mogu se preklopiti;
 *   visina docka prenosi se tekstu slajda kroz --hero-dock-h
 * - indikator napretka u aktivnoj točkici
 * - prva slika u HTML-u s fetchpriority="high"; ostale se učitavaju tek prije prikaza
 */
import Picture from './Picture.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import BookingBar from './BookingBar.astro';
import { useTranslations } from '@/i18n';
import { resolveHref } from '@/lib/links';
import type { CollectionEntry } from 'astro:content';

type Slide = NonNullable<CollectionEntry<'pages'>['data']['heroSlides']>[number];
interface Props {
  slides: Slide[];
  locale: string;
  heading: string;
  intervalMs: number;
  maxSmall: number;
}
const { slides, locale, heading, intervalMs, maxSmall } = Astro.props;
const t = useTranslations(locale);
const n = slides.length;
---

<section
  class="hero"
  aria-roledescription="carousel"
  aria-label={t('slider.label')}
  data-hero
  data-interval={intervalMs}
  data-label-pause={t('slider.pause')}
  data-label-play={t('slider.play')}
  style={`--hero-interval:${intervalMs}ms`}
>
  <div class="hero__media" data-media>
    <h1 class="visually-hidden">{heading}</h1>
    <div class="hero__slides" aria-live="off" data-slides>
      {
        slides.map((slide, i) => (
          <div
            class:list={['hero__slide', { 'is-active': i === 0 }]}
            role="group"
            aria-roledescription="slide"
            aria-label={`${t('slider.slide')} ${i + 1} ${t('slider.of')} ${n}: ${slide.title}`}
            aria-hidden={i === 0 ? undefined : 'true'}
            data-slide
            data-small-hidden={slide.hideOnSmallScreens || i >= maxSmall ? 'true' : undefined}
          >
            <Picture
              src={slide.image.src}
              alt={slide.image.alt}
              sizes="100vw"
              class="hero__picture"
              imgClass="hero__img"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              deferred={i > 0}
            />
            <div class="hero__content container">
              <div class="hero__text" data-hold>
                {slide.eyebrow && <p class="hero__kicker">{slide.eyebrow}</p>}
                <h2 class="hero__title">{slide.title}</h2>
                <p class="hero__subtitle">{slide.subtitle}</p>
                <Button href={resolveHref(slide.cta.href, locale)} size="l" icon="arrowRight" tabindex={i === 0 ? undefined : '-1'}>
                  {slide.cta.label}
                </Button>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="hero__dock" data-dock>
    <div class="hero__dock-inner container">
      {
        n > 1 && (
          <div class="hero__controls" data-controls>
            <div class="hero__dots" role="group" aria-label={t('slider.label')}>
              {slides.map((slide, i) => (
                <button
                  type="button"
                  class="hero__dot"
                  aria-label={`${t('slider.goTo')} ${i + 1}: ${slide.title}`}
                  aria-current={i === 0 ? 'true' : undefined}
                  data-dot={i}
                  data-small-hidden={slide.hideOnSmallScreens || i >= maxSmall ? 'true' : undefined}
                >
                  <span aria-hidden="true" />
                </button>
              ))}
            </div>
            <div class="hero__buttons">
              <button type="button" class="hero__btn" data-prev aria-label={t('slider.prev')}>
                <Icon name="chevronLeft" />
              </button>
              <button type="button" class="hero__btn" data-toggle aria-label={t('slider.pause')}>
                <Icon name="pause" class="hero__icon-pause" />
                <Icon name="play" class="hero__icon-play" />
              </button>
              <button type="button" class="hero__btn" data-next aria-label={t('slider.next')}>
                <Icon name="chevronRight" />
              </button>
            </div>
          </div>
        )
      }
      <div class="hero__booking">
        <BookingBar locale={locale} variant="hero" id="hero-booking" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--c-dark);
    --hero-dock-h: 10rem; /* zamjenska vrijednost dok JS ne izmjeri stvarnu visinu docka */
  }
  .hero__media {
    position: relative;
    height: min(78svh, 46rem);
    min-height: 31rem;
    overflow: hidden;
    color: #fff;
  }
  .hero__slides,
  .hero__slide {
    position: absolute;
    inset: 0;
  }
  .hero__slide {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 1.2s var(--ease-out),
      visibility 0s linear 1.2s;
  }
  .hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 1.2s var(--ease-out);
  }
  .hero__slide :global(.hero__picture),
  .hero__slide :global(.hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__slide :global(.hero__img) {
      transform: scale(1.06);
      transition: transform 7s linear;
    }
    .hero__slide.is-active :global(.hero__img) {
      transform: scale(1);
    }
  }
  /* Zatamnjenje radi čitljivosti teksta (kontrast ≥ 4,5:1) */
  .hero__slide::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(20 16 14 / 0.78) 0%, rgb(20 16 14 / 0.35) 45%, rgb(20 16 14 / 0.1) 75%),
      linear-gradient(to right, rgb(20 16 14 / 0.45), transparent 70%);
  }
  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    height: 100%;
    padding-bottom: var(--s-5);
  }
  .hero__text {
    max-width: 38rem;
  }
  .hero__kicker {
    margin-bottom: var(--s-2);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.9);
  }
  .hero__title {
    font-size: var(--step-5);
    font-weight: 600;
    line-height: 1;
    color: #fff;
  }
  .hero__subtitle {
    max-width: 34rem;
    margin-block: var(--s-2) var(--s-3);
    font-size: var(--step-1);
    line-height: 1.45;
    color: rgb(255 255 255 / 0.92);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__slide .hero__text > * {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 0.8s var(--ease-out),
        transform 0.8s var(--ease-out);
    }
    .hero__slide.is-active .hero__text > * {
      opacity: 1;
      transform: none;
    }
    .hero__slide.is-active .hero__text > :nth-child(2) {
      transition-delay: 0.15s;
    }
    .hero__slide.is-active .hero__text > :nth-child(3) {
      transition-delay: 0.3s;
    }
    .hero__slide.is-active .hero__text > :nth-child(4) {
      transition-delay: 0.45s;
    }
  }

  /* ---------- dock: kontrole + booking traka u jednom stupcu (ne mogu se preklopiti) */
  .hero__dock {
    position: relative;
    z-index: 3;
    padding-block: var(--s-2) var(--s-3);
    padding-inline: env(safe-area-inset-left) env(safe-area-inset-right);
  }
  .hero__dock-inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .hero__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-1) var(--s-2);
    color: #fff;
  }
  .hero__dots {
    display: flex;
    flex-wrap: wrap;
  }
  .hero__dot {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 0;
    background: none;
  }
  .hero__dot span {
    position: relative;
    display: block;
    width: 28px;
    height: 3px;
    border-radius: 2px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.4);
    transition: width var(--dur-m) var(--ease-out);
  }
  .hero__dot[aria-current='true'] span {
    width: 40px;
  }
  /* Indikator napretka: puni se do sljedećeg slajda; kad slider stoji, aktivna točkica je puna */
  .hero__dot span::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left center;
  }
  .hero__dot[aria-current='true'] span::after {
    transform: scaleX(1);
  }
  .hero.is-playing .hero__dot[aria-current='true'] span::after {
    animation: hero-progress var(--hero-interval) linear forwards;
  }
  @keyframes hero-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  .hero__buttons {
    display: flex;
    gap: var(--s-1);
  }
  .hero__btn {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.55);
    border-radius: 50%;
    background: rgb(20 16 14 / 0.35);
    color: #fff;
    transition: background-color var(--dur-s);
  }
  .hero__btn:hover {
    background: rgb(20 16 14 / 0.65);
  }
  .hero__btn :global(.hero__icon-play) {
    display: none;
  }
  .hero.is-paused .hero__btn :global(.hero__icon-play) {
    display: block;
  }
  .hero.is-paused .hero__btn :global(.hero__icon-pause) {
    display: none;
  }

  @media (max-width: 29.99em) {
    .hero [data-small-hidden='true'] {
      display: none;
    }
  }

  /* Računalo: dock leži preko donjeg dijela slike; tekst slajda podiže se za izmjerenu visinu docka */
  @media (min-width: 64em) {
    .hero__media {
      height: min(100svh, 60rem);
      min-height: max(40rem, calc(var(--hero-dock-h) + 26rem));
    }
    .hero__content {
      padding-bottom: calc(var(--hero-dock-h) + var(--s-4) + var(--s-3));
    }
    .hero__dock {
      position: absolute;
      left: 0;
      right: 0;
      bottom: max(var(--s-4), env(safe-area-inset-bottom));
      padding-block: 0;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
    const allSlides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const allDots = [...hero.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const live = hero.querySelector<HTMLElement>('[data-slides]')!;
    const media = hero.querySelector<HTMLElement>('[data-media]')!;
    const dock = hero.querySelector<HTMLElement>('[data-dock]')!;
    const toggle = hero.querySelector<HTMLButtonElement>('[data-toggle]');
    const interval = Number(hero.dataset.interval) || 5000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const small = window.matchMedia('(max-width: 29.99em)');

    // Visina docka → CSS varijabla (tekst slajda nikad ne ide ispod kontrola i booking trake)
    new ResizeObserver(() => hero.style.setProperty('--hero-dock-h', `${dock.offsetHeight}px`)).observe(dock);

    if (allSlides.length < 2) return;

    // Samo u razvoju: ?autoplay=1 uključuje izmjenu i uz prefers-reduced-motion (radi testiranja)
    const forceAutoplay = import.meta.env.DEV && new URLSearchParams(location.search).get('autoplay') === '1';

    let current = 0;
    let timer: number | undefined;
    let userPaused = reduced.matches && !forceAutoplay; // trajna pauza (gumb ili smanjeno kretanje)
    let hoverHold = false; // privremeno: miš iznad teksta slajda ili kontrola
    let focusHold = false; // privremeno: fokus s tipkovnice ili u booking traci
    let offscreen = false; // privremeno: hero nije na ekranu

    const visible = () => allSlides.map((_, i) => i).filter((i) => !(small.matches && allSlides[i].dataset.smallHidden));

    const load = (i: number) => {
      const slide = allSlides[i];
      slide?.querySelectorAll<HTMLElement>('[data-srcset]').forEach((el) => {
        el.setAttribute('srcset', el.dataset.srcset!);
        el.removeAttribute('data-srcset');
      });
      slide?.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
        img.src = img.dataset.src!;
        img.removeAttribute('data-src');
      });
    };

    const show = (i: number) => {
      current = i;
      allSlides.forEach((slide, idx) => {
        const active = idx === i;
        slide.classList.toggle('is-active', active);
        slide.toggleAttribute('inert', !active);
        if (active) slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
        slide.querySelectorAll<HTMLElement>('a').forEach((a) => (active ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
      });
      allDots.forEach((dot, idx) => (idx === i ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current')));
      const order = visible();
      load(i);
      load(order[(order.indexOf(i) + 1) % order.length]); // unaprijed učitaj sljedeći
    };

    const step = (dir: 1 | -1) => {
      const order = visible();
      const pos = order.indexOf(current);
      show(order[(pos + dir + order.length) % order.length]);
    };

    const isPlaying = () => !userPaused && !hoverHold && !focusHold && !offscreen && !document.hidden;

    /** (Ponovno) pokreće odbrojavanje od punih N ms i sinkronizira indikator napretka. */
    const schedule = () => {
      window.clearTimeout(timer);
      const playing = isPlaying();
      hero.classList.toggle('is-paused', userPaused);
      hero.classList.remove('is-playing');
      if (playing) {
        void hero.offsetWidth; // restart CSS animacije indikatora
        hero.classList.add('is-playing');
        timer = window.setTimeout(() => {
          step(1);
          schedule();
        }, interval);
      }
      toggle?.setAttribute('aria-label', userPaused ? hero.dataset.labelPlay! : hero.dataset.labelPause!);
      live.setAttribute('aria-live', playing ? 'off' : 'polite');
    };

    // Ručna navigacija: prijelaz + novo odbrojavanje; autoplay se NE gasi
    hero.querySelector('[data-next]')?.addEventListener('click', () => (step(1), schedule()));
    hero.querySelector('[data-prev]')?.addEventListener('click', () => (step(-1), schedule()));
    allDots.forEach((dot) => dot.addEventListener('click', () => (show(Number(dot.dataset.dot)), schedule())));
    toggle?.addEventListener('click', () => {
      userPaused = !userPaused;
      schedule();
    });

    // Privremena pauza na hover – samo iznad teksta slajda, ne iznad cijele fotografije ni kontrola
    hero.querySelectorAll<HTMLElement>('[data-hold]').forEach((el) => {
      el.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') (hoverHold = true), schedule();
      });
      el.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse') (hoverHold = false), schedule();
      });
    });

    // Privremena pauza na fokus – s tipkovnice (:focus-visible) ili u booking traci; klik mišem na strelicu ne pauzira
    hero.addEventListener('focusin', (e) => {
      const target = e.target as HTMLElement;
      focusHold = target.matches(':focus-visible') || !!target.closest('.booking-bar');
      schedule();
    });
    hero.addEventListener('focusout', (e) => {
      if (!hero.contains(e.relatedTarget as Node)) {
        focusHold = false;
        schedule();
      }
    });

    document.addEventListener('visibilitychange', schedule);
    new IntersectionObserver(([entry]) => {
      offscreen = !entry.isIntersecting;
      schedule();
    }).observe(media);

    // Strelice tipkovnice (ne dok se tipka u booking traci)
    hero.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).closest('.booking-bar')) return;
      if (e.key === 'ArrowRight') (step(1), schedule());
      if (e.key === 'ArrowLeft') (step(-1), schedule());
    });

    // Swipe na dodirnim zaslonima
    let startX = 0;
    let startY = 0;
    media.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startY = e.clientY;
    });
    media.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(e.clientY - startY)) (step(dx < 0 ? 1 : -1), schedule());
    });

    small.addEventListener('change', () => {
      if (!visible().includes(current)) show(visible()[0]);
    });
    reduced.addEventListener('change', (e) => {
      if (e.matches && !forceAutoplay) userPaused = true;
      schedule();
    });

    show(0);
    schedule();
  });
</script>
