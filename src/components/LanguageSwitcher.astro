---
/**
 * Prekidač jezika – vodi na ISTU stranicu na drugom jeziku (ne na naslovnicu).
 * Prikazuje samo uključene jezike iz src/i18n/config.ts.
 */
import { alternatesFor, type PageKey } from '@/i18n/routes';
import { useTranslations } from '@/i18n';

interface Props {
  locale: string;
  pageKey: PageKey;
  variant?: 'header' | 'menu';
}
const { locale, pageKey, variant = 'header' } = Astro.props;
const t = useTranslations(locale);
const alternates = alternatesFor(pageKey);
---

{
  alternates.length > 1 && (
    <nav class:list={['lang', `lang--${variant}`]} aria-label={t('lang.switch')}>
      <ul role="list">
        {alternates.map((alt) => (
          <li>
            <a
              href={alt.path}
              hreflang={alt.hreflang}
              lang={alt.hreflang}
              aria-current={alt.locale === locale ? 'true' : undefined}
              data-lang-link
            >
              <span aria-hidden="true">{alt.label}</span>
              <span class="visually-hidden">
                {alt.name}
                {alt.locale === locale ? ` (${t('lang.current')})` : ''}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .lang ul {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }
  .lang li + li::before {
    content: '/';
    opacity: 0.45;
    margin-inline: 0.1rem;
  }
  .lang li {
    display: flex;
    align-items: center;
  }
  .lang a {
    display: inline-grid;
    place-items: center;
    min-width: var(--tap);
    min-height: var(--tap);
    padding-inline: 0.35rem;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: inherit;
    text-decoration: none;
    opacity: 0.72;
  }
  .lang a:hover {
    opacity: 1;
    color: inherit;
  }
  .lang a[aria-current] {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 0.45em;
    text-decoration-thickness: 2px;
  }
  .lang--menu a {
    font-size: var(--step-0);
  }
</style>
